<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFA"
    tools:context=".MainActivity5">

    <TextView
        android:id="@+id/titel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Car Designer"
        android:textColor="#222222"
        android:textSize="40sp"
        android:textStyle="bold"
        android:layout_marginTop="65dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/check"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:text="✓"
        android:textSize="75sp"
        android:textColor="#E52525"
        android:gravity="center"
        android:layout_marginTop="80dp"
        app:layout_constraintTop_toBottomOf="@id/titel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/bestellingGelukt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Bestelling gelukt!"
        android:textColor="#E52525"
        android:textSize="30sp"
        android:textStyle="bold"
        android:layout_marginTop="25dp"
        app:layout_constraintTop_toBottomOf="@id/check"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/bedankt"
        android:layout_width="300dp"
        android:layout_height="wrap_content"
        android:text="Bedankt voor je bestelling bij Car Designer. Veel plezier met je nieuwe auto!"
        android:textColor="#333333"
        android:textSize="18sp"
        android:gravity="center"
        android:layout_marginTop="20dp"
        app:layout_constraintTop_toBottomOf="@id/bestellingGelukt"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <Button
        android:id="@+id/buttonTerug"
        android:layout_width="250dp"
        android:layout_height="55dp"
        android:text="Terug"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:backgroundTint="#E52525"
        android:layout_marginBottom="80dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
